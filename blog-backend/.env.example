# Template for local secrets. Copy it and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is git-ignored; this `.env.example` file is committed on purpose.
# It is loaded by `spring.config.import` in application.yml.
#
# Format notes (the file is parsed as Java .properties, NOT as a shell env file):
#   - Do NOT quote values.  DB_PASSWORD="abc"  keeps the literal quote characters.
#   - Do NOT prefix with `export`.
#   - Escape backslashes:   a\b  must be written  a\\b
#   - Keep keys and values ASCII-only; the parser reads this file as ISO-8859-1.
#   - A real OS environment variable of the same name overrides this file.

# --- MySQL ---
# Optional: application.yml falls back to root / 123456 when these are absent.
DB_USERNAME=root
DB_PASSWORD=123456

# --- JWT signing key ---
# REQUIRED: there is no default in application.yml, the app will not start without it.
# Must be at least 32 characters (256 bit) -- JwtUtil derives the key with
# Keys.hmacShaKeyFor(), which throws WeakKeyException on anything shorter.
# Generate one with:  openssl rand -base64 48
# Rotating this value invalidates every token already issued (users must log in again).
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-chars
